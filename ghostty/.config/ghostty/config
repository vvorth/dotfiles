# vim: set ft=config:

theme = Selenized Dark
font-family = CaskaydiaCove Nerd Font Mono
font-size = 15
mouse-hide-while-typing = true
window-decoration = true
macos-option-as-alt = true
window-padding-balance = true
window-padding-x = 3
window-padding-y = 3
background-opacity = 0.9
background-blur-radius = 20
# macos-window-buttons = hidden
# macos-titlebar-style = tabs
macos-titlebar-style = transparent
# macos-titlebar-style = hidden
copy-on-select = clipboard

# keybind = shift+up=scroll_page_lines:-20
# keybind = shift+down=scroll_page_lines:20
keybind = shift+up=scroll_page_lines:-1
keybind = shift+down=scroll_page_lines:1
keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down

keybind = super+c=copy_to_clipboard:plain

