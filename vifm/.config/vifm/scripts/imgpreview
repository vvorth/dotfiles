#!/usr/bin/env bash
#
# imgpreview: draw/clear an image (or video-thumbnail) preview for vifm.
#
# Renderer tiers:
#   1. chafa, in its own auto-detect mode -- it identifies the terminal's
#      graphics protocol (kitty/iTerm2/sixel) itself, *including* inside
#      tmux or GNU screen (it chains outer-multiplexer + inner-terminal
#      detection and manages tmux's `allow-passthrough` on its own), and
#      falls back to colored Unicode/ANSI block art if none is found.
#      Earlier versions of this script tried to guess the terminal/
#      protocol itself and force it via `-f`, but that used weaker
#      heuristics than chafa's own and broke under tmux (which hides most
#      terminal-identifying env vars from panes unless explicitly
#      forwarded) -- just trust chafa here.
#   2. ascii-image-converter, then jp2a (plain ascii art, only used if
#      chafa itself is not installed)
#
# For clearing, the kitty graphics protocol's "delete all images" command
# is sent unconditionally (wrapped for tmux/screen passthrough when
# applicable) rather than trying to detect whether chafa actually used
# that protocol: terminals that don't understand it silently ignore
# unrecognized APC sequences by design, so it's a harmless no-op on
# sixel/iTerm2/plain terminals and only does real work where it's needed.
#
# tmux users: add to tmux.conf for graphics to reach the real terminal:
#   set -g allow-passthrough on
#
# Both the draw and clear commands are registered in vifmrc with the %pd
# macro, which marks this as a "pass-through" previewer: vifm sends its
# output straight to the terminal instead of capturing/redrawing it
# through its own ncurses layer. Without %pd, chafa's real graphics-
# protocol bytes (unlike e.g. `kitty icat`, which writes to /dev/tty
# directly and so doesn't need this) get corrupted by that layer -- this
# is what vifm's docs mean by "likely to mangle terminal state", and
# matches literal escape-code garbage showing up in the preview pane.
#
# Usage (see vifmrc):
#   imgpreview draw image <file> <pw> <ph>
#   imgpreview draw video <file> <pw> <ph>
#   imgpreview clear

set -uo pipefail

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/vifm/thumbnails"
ESC=$'\033'
kitty_clear_seq="${ESC}_Ga=d,d=A${ESC}\\"

# Wrap a raw escape sequence for tmux/screen's DCS passthrough (doubling
# any ESC bytes it contains, as the passthrough envelope requires) so it
# reaches the real terminal instead of being eaten by the multiplexer.
send_passthrough () {
    local payload="${1//$ESC/$ESC$ESC}"
    if [[ -n "${TMUX:-}" ]]; then
        printf '%sPtmux;%s%s\\' "$ESC" "$payload" "$ESC"
    elif [[ -n "${STY:-}" ]]; then
        printf '%sP%s%s\\' "$ESC" "$payload" "$ESC"
    else
        printf '%s' "$1"
    fi
}

action="${1:-}"
shift || true

if [[ "$action" == clear ]]; then
    send_passthrough "$kitty_clear_seq"
    exit 0
fi

kind="${1:-image}"; file="$2"; pw="$3"; ph="$4"

[[ -r "$file" ]] || { echo "(cannot read file)"; exit 1; }

if [[ "$kind" == video ]]; then
    if ! command -v ffmpegthumbnailer >/dev/null 2>&1; then
        echo "install ffmpegthumbnailer for video thumbnails"
        exit 1
    fi
    mkdir -p "$CACHE_DIR"
    mtime="$(stat -c %Y -- "$file" 2>/dev/null || stat -f %m -- "$file" 2>/dev/null)"
    key="$(printf '%s %s' "$file" "$mtime" | cksum | cut -d' ' -f1)"
    thumb="$CACHE_DIR/$key.jpg"
    if [[ ! -s "$thumb" ]]; then
        ffmpegthumbnailer -i "$file" -o "$thumb" -s 0 -q 10 2>/dev/null \
            || { echo "(could not generate thumbnail)"; exit 1; }
    fi
    file="$thumb"
fi

if command -v chafa >/dev/null 2>&1; then
    chafa --size="${pw}x${ph}" -- "$file"
    exit 0
fi

if command -v ascii-image-converter >/dev/null 2>&1; then
    ascii-image-converter -C -- "$file"
    exit 0
fi

if command -v jp2a >/dev/null 2>&1; then
    jp2a --colors --width="$pw" --height="$ph" -- "$file"
    exit 0
fi

command -v identify >/dev/null 2>&1 && identify -- "$file"
echo "no image preview tool found (install chafa)"
