#!/usr/bin/env bash
#
# imgpreview: draw/clear an image (or video-thumbnail) preview for vifm.
#
# Picks the best available renderer at preview time:
#   1. chafa, forced to the kitty graphics protocol on terminals known to
#      speak it (kitty, Ghostty, WezTerm) -- real image, no extra
#      dependency: chafa implements the protocol itself, no need for the
#      `kitty` binary even outside the actual kitty terminal.
#   2. chafa in auto mode on everything else -- it probes the terminal
#      itself for sixel/iTerm2 support and falls back to colored
#      Unicode/ANSI block art if the terminal can't do real graphics.
#   3. ascii-image-converter, then jp2a                  (plain ascii art,
#      only used if chafa itself is not installed)
#
# Usage (see vifmrc):
#   imgpreview draw image <file> <pw> <ph> <px> <py>
#   imgpreview draw video <file> <pw> <ph> <px> <py>
#   imgpreview clear

set -uo pipefail

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/vifm/thumbnails"

# Terminals that implement the kitty graphics protocol, whether or not the
# `kitty` terminal app itself is installed (Ghostty and WezTerm both do).
kitty_protocol_terminal() {
    [[ -n "${KITTY_WINDOW_ID:-}" ]] && return 0
    [[ -n "${GHOSTTY_RESOURCES_DIR:-}" ]] && return 0
    [[ "${TERM_PROGRAM:-}" == "WezTerm" ]] && return 0
    case "${TERM:-}" in
        xterm-kitty|xterm-ghostty) return 0 ;;
    esac
    return 1
}

action="${1:-}"
shift || true

if [[ "$action" == clear ]]; then
    # Real graphics-protocol images are a persistent overlay that needs an
    # explicit erase (APC delete-all-images command); chafa's symbol/ANSI
    # fallback and the ascii tools just print plain text that the next
    # redraw overwrites on its own.
    if kitty_protocol_terminal; then
        printf '\033_Ga=d,d=A\033\\'
    fi
    exit 0
fi

kind="${1:-image}"; file="$2"; pw="$3"; ph="$4"; px="$5"; py="$6"

[[ -r "$file" ]] || { echo "(cannot read file)"; exit 1; }

if [[ "$kind" == video ]]; then
    if ! command -v ffmpegthumbnailer >/dev/null 2>&1; then
        echo "install ffmpegthumbnailer for video thumbnails"
        exit 1
    fi
    mkdir -p "$CACHE_DIR"
    mtime="$(stat -c %Y -- "$file" 2>/dev/null || stat -f %m -- "$file" 2>/dev/null)"
    key="$(printf '%s %s' "$file" "$mtime" | cksum | cut -d' ' -f1)"
    thumb="$CACHE_DIR/$key.jpg"
    if [[ ! -s "$thumb" ]]; then
        ffmpegthumbnailer -i "$file" -o "$thumb" -s 0 -q 10 2>/dev/null \
            || { echo "(could not generate thumbnail)"; exit 1; }
    fi
    file="$thumb"
fi

if command -v chafa >/dev/null 2>&1; then
    if kitty_protocol_terminal; then
        chafa -f kitty --size="${pw}x${ph}" -- "$file"
    else
        chafa --size="${pw}x${ph}" -- "$file"
    fi
    exit 0
fi

if command -v ascii-image-converter >/dev/null 2>&1; then
    ascii-image-converter -C -- "$file"
    exit 0
fi

if command -v jp2a >/dev/null 2>&1; then
    jp2a --colors --width="$pw" --height="$ph" -- "$file"
    exit 0
fi

command -v identify >/dev/null 2>&1 && identify -- "$file"
echo "no image preview tool found (install chafa)"
